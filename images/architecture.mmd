flowchart LR

  %% Internal network zone
  subgraph InternalNetwork["Internal Network (Isolated)"]
    A["Parrot Attacker"]
    B["Windows 10 Victim (Sysmon + Wazuh Agent)"]
    Z["Zeek Sensor"]
    WA["Wazuh Agent"]
    A -->|Attack traffic| B
    A -->|Probes / Scans| Z
    B -->|Sysmon events| WA
  end

  %% SIEM zone with dual NIC explanation
  subgraph SIEM["SIEM VM (Xubuntu)"]
    direction TB
    note1["Primary NIC: Internal Network"]
    note2["Secondary NIC: NAT (for updates & Dashboard access)"]
    W["Wazuh Manager"]
    I["Wazuh Indexer (replaces Elasticsearch)"]
    D["Wazuh Dashboard (replaces Kibana)"]

    W -->|Send alerts & logs| I
    I -->|Display & visualization| D

    note1 --- W
    note2 --- D
  end

  %% Data flows
  Z -->|"Zeek logs (conn/http/dns)"| I
  WA -->|Agent telemetry| W

  %% Internet connectivity
  Internet((Internet))
  SIEM -. NAT traffic .-> Internet
